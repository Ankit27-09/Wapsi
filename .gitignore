# secrets
.env
.env.local
.env.*.local

# build output
dist/
*.tsbuildinfo
.next/
out/

# deps
node_modules/
.pnpm-store/

# test / coverage
coverage/
.vitest/

# eval artefacts — regenerated by `pnpm eval`, never committed.
# The committed evidence is the README table; the raw run output is reproducible.
artifacts/
!artifacts/.gitkeep

# editor / os
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json

# Synthesised call audio. Regenerated on demand from the registered script, so it is
# build output rather than source — and a WAV is a megabyte a minute.
apps/web/public/audio/
