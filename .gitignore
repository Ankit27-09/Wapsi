# secrets
.env
.env.local
.env.*.local

# build output
dist/
*.tsbuildinfo
.next/
out/

# deps
node_modules/
.pnpm-store/

# test / coverage
coverage/
.vitest/

# eval artefacts — regenerated by `pnpm eval`, never committed.
# The committed evidence is the README table; the raw run output is reproducible.
# `artifacts/*` rather than `artifacts/`, and the difference is not cosmetic: git cannot
# re-include a file whose PARENT DIRECTORY is excluded, so with `artifacts/` the negation
# below silently did nothing and `.gitkeep` was never tracked. Excluding the contents instead
# leaves the directory itself includable, which is the only way to keep an empty folder.
artifacts/*
!artifacts/.gitkeep

# editor / os
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json

# Synthesised call audio. Regenerated on demand from the registered script, so it is
# build output rather than source — and a WAV is a megabyte a minute.
apps/web/public/audio/
