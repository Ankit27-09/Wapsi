# Copy to .env — never commit .env
# Validated by Zod at boot; the process fails fast on a missing or malformed value.

# --- infrastructure ---------------------------------------------------------
# Ports are non-default (5433 / 6380) so the stack never collides with a local
# Postgres or Redis a judge already has running.
DATABASE_URL=postgres://rc:rc_local_only@localhost:5433/recovery_controller
REDIS_URL=redis://localhost:6380

# --- model access -----------------------------------------------------------
# Optional. Without a key the eval still runs: the LLM classification arm is skipped
# with a clear message and the free keyword arm reports on its own.
#
# Two providers, both with a free tier and no card required:
#   GEMINI_API_KEY   aistudio.google.com/apikey
#   GROQ_API_KEY     console.groq.com/keys
#
# Set either. With both set, GEMINI is used unless LLM_PROVIDER says otherwise —
# and running the ablation against each in turn is the interesting comparison,
# because classification here is a mechanical mapping task and the point is to find
# out how little model it actually needs.
GEMINI_API_KEY=...
GROQ_API_KEY=...

# gemini | groq. Omit to use whichever key is present.
LLM_PROVIDER=

# Omit for the provider's default: gemini-3.1-flash-lite, or openai/gpt-oss-20b.
# Any model named here must have a price in packages/ai/src/cost.ts — an unpriced
# model would make every rupee figure in the ablation quietly wrong, so it fails at
# startup instead.
LLM_MODEL=

# How many classifications run at once. DEFAULTS TO 2 BECAUSE FREE TIERS ARE THE
# COMMON CASE, and this number decides whether the ablation measures the model or the
# rate limiter.
#
# Measured, on the same seed and population: at 8, Groq rejected 13 of 40 calls and
# Gemini 19 of 40, and both LLM arms then landed near the keyword baseline. At 1, all
# 25 calls succeeded and the Gemini arm captured 97.8% of the legal ceiling against
# the baseline's 26.5%. The throttled runs were not a result about classification —
# they were a result about quota, reported in the same column.
#
# The `failed` column in `pnpm ablate` now separates the two, so a throttled run is
# visible as one. Raise this only on a paid tier.
CLASSIFY_CONCURRENCY=2

# Rupees per US dollar, in paise, for converting published per-token prices into the
# cost model. An ASSUMPTION, stated here rather than buried: ₹88.00 to the dollar.
# Every model cost in the report scales linearly with it.
USD_INR_PAISE=8800

# Calibrated confidence below this routes a transaction to the exception queue instead
# of acting on it. Chosen from the reliability curve in the report, not by feel.
CLASSIFY_CONFIDENCE_FLOOR_BPS=6000

# --- Speech, for the Hinglish call scripts -----------------------------------
# Optional. Without a key, `pnpm voice` prints the exact script that would be spoken and
# names the provider that would render it, so the whole path is inspectable with no
# credentials and no network. `--speak` is what synthesises audio.
#
#   SARVAM_API_KEY   dashboard.sarvam.ai — built for Indian code-mixed speech
#   GEMINI_API_KEY   reused from above   — general multilingual
#
# SARVAM IS PREFERRED when both are set, which is the opposite of the classifier's default
# and deliberate: classification is language-agnostic and Gemini is priced better for it,
# while this is specifically Hinglish and Bulbul is trained on how Indians actually say
# "dabaayein". Naming one with VOICE_PROVIDER overrides the preference either way.
SARVAM_API_KEY=...

# gemini | sarvam. Omit to use whichever key is present.
VOICE_PROVIDER=

# Omit for the provider default: gemini-3.1-flash-tts-preview, or bulbul:v3.
VOICE_MODEL=

# --- Razorpay, test mode only -----------------------------------------------
# Optional. Without these, `pnpm razorpay` runs as a dry run and prints the exact JSON it
# would POST, so the integration is inspectable with no credentials and no network.
#
# A LIVE KEY IS REFUSED, by validation rather than by a warning. `pnpm razorpay` creates
# PAYMENT LINKS — demands for money — against customers a simulator invented, so a
# `rzp_live_` key here fails to load. There is no flag to override that.
#
# Get test keys free at dashboard.razorpay.com (no KYC needed for test mode):
#   check the toggle says Test Mode → Settings → API Keys → Generate Test Key
RAZORPAY_KEY_ID=rzp_test_...
RAZORPAY_KEY_SECRET=...

# --- determinism ------------------------------------------------------------
# Every run is reproducible from this seed. `pnpm eval --seed 99` should produce
# different transactions and materially similar conclusions.
EVAL_SEED=42

# --- cost ceilings ----------------------------------------------------------
# ENFORCED. Checked before every model call, not after — so the call that would breach
# the cap never happens. A breach halts the batch and writes an audit row with
# actor = 'cost_ceiling', and the transactions already decided stand.
#
# Defaulted to these figures in code as well, so the ceiling is in force whether or not
# this file exists. A safety control that only works when somebody remembers to
# configure it is a suggestion.
#
# Undiagnosed transactions are left to a human rather than guessed at: they reach the
# planner as `unknown`, which permits no attempts and escalates.
MAX_LLM_CALLS_PER_BATCH=1200
MAX_LLM_COST_PAISE_PER_BATCH=200000

# --- operator auth ----------------------------------------------------------
# ENFORCED on `pnpm propose --approve` and `--reject`, which change the rules that move
# money. Compared with a constant-time digest comparison, so neither the length nor the
# common prefix of the secret is observable from how long the check takes.
#
# THE VALUE BELOW WILL NOT WORK. It is published in this repository, so authenticating
# against it establishes nothing — the gate refuses it by name, along with anything
# shorter than 16 characters. Replace it.
#
#   pnpm propose --approve 3 --token "$OPERATOR_TOKEN" --operator "human:your-name"
#
# What this is not: identity, non-repudiation, or per-operator access control. It
# establishes that whoever ran the command held the secret. Real deployment wants SSO.
OPERATOR_TOKEN=change-me-locally

# --- misc -------------------------------------------------------------------
LOG_LEVEL=info
NODE_ENV=development
